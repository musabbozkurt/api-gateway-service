    {
      "name": "Create New Email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var response = xml2Json(pm.response.text());",
              "postman.setGlobalVariable(\"email_id\", response.ApiEmailResponse.id);",
              "postman.setGlobalVariable(\"email_address\", response.ApiEmailResponse.emailAddress);",
              "console.log(response.ApiEmailResponse);",
              ""
            ],
            "type": "text/javascript"
